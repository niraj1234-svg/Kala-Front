PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kala?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin Account Seeder Configuration (backend/.env)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PHONE=

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Service Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_email@gmail.com
EMAIL_PASSWORD=your_smtp_app_password
EMAIL_FROM="KALA" <noreply@kala.com>
ADMIN_NOTIFICATION_EMAIL=dhoreniraj83@gmail.com

# Designathon Configuration (Optional for development/testing override)
# DESIGNATHON_WINDOW_OVERRIDE=open

# Cloudflare R2 / S3-Compatible Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com

# Shiprocket Logistics Integration (Credentials managed in Render)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=


