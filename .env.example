# ==================================================
# KALA STUDIO CONFIGURATION & ENVIRONMENT VARIABLES
# ==================================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or local)
# Leave empty to use built-in synced JSON database storage
MONGODB_URI=

# JWT Secret for User & Admin sessions
JWT_SECRET=kala_originals_super_secret_jwt_key_2026

# Email / SMTP Credentials (for meeting booking alerts and customer confirmation triggers)
# If left blank, emails are displayed in server console preview mode
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=KalaOriginals@gmail.com

# Default Administrator Account
ADMIN_EMAIL=admin@kala.com
ADMIN_PASSWORD=admin12345

# Google OAuth Credentials (optional, for Google Sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Brand & Form URLs
NEXT_PUBLIC_GOOGLE_FORM_URL=https://forms.gle/dV5JjZBfq26gabat9
NEXT_PUBLIC_WHATSAPP_NUMBER=9406030116
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kala_originals/
